{
  "name": "COSC 2060: Modern Data Engineering & AI Infrastructure Sandbox",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "vscode",
  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PIP_NO_CACHE_DIR": "1",
    "DUCKDB_DB_PATH": "/workspaces/${localWorkspaceFolderBasename}/datasets/apex_logistics.duckdb",
    "HF_HOME": "/home/vscode/.cache/huggingface"
  },
  "forwardPorts": [8000, 3000],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI DaaS Gateway (Unit 5 & 8)",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Orchestration / Telemetry UI (Unit 7)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "mechatroner.rainbow-csv",
        "dvirtz.parquet-viewer"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/python/current/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "jupyter.askForKernelRestart": false,
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n",
        "editor.formatOnSave": false,
        "editor.rulers": [100]
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/setup_sandbox.sh"
}
